{
	"folders": [
		{
			"name": "tz_int",
			"path": "."
		}
	],
	"settings": {
		"files.exclude": {
			"**/__pycache__": true,
			"**/*.pyc": true,
			"**/.pytest_cache": true,
			"**/*.egg-info": true
		},
		"search.exclude": {
			"**/.venv": true,
			"**/__pycache__": true
		},
		"python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
		"python.analysis.extraPaths": [
			"${workspaceFolder}"
		],
		"python.analysis.diagnosticMode": "workspace",
		"[python]": {
			"editor.formatOnSave": true,
			"editor.tabSize": 4
		},
		"files.associations": {
			"docker-compose.yml": "dockercompose",
			".env.example": "dotenv"
		}
	}
}
